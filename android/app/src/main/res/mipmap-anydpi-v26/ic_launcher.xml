<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon for Android 8.0+.
    The foreground PNG has an 18 % transparent border added by
    tool/make_adaptive_fg.dart so the centred chicken fits the safe
    circle of every launcher mask (square / rounded / circle). No
    <inset> wrapper — double-shrinking would make the subject too small.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
